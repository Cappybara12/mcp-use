# Optional. Without any of these the receiver runs in demo mode on bundled sample data.

# Attach the real pipeline (paths to your local checkouts)
# WAYZYY_WRITER_DIR=/path/to/article-writer
# WAYZYY_SCANNER_DIR=/path/to/24-7-chronically-online
# WAYZYY_SITE_DIR=/path/to/site-repo        # only needed for push_to_github
# GITHUB_TOKEN=                             # only needed for push_to_github

# Retarget the pipeline to another niche (brand, categories, suggestion keywords, style rules)
# PIPELINE_CONFIG=receiver/config/examples/saas/config.yaml

# Ports / hosts
# GRAFT_PORT=8080
# GRAFT_VISION_PORT=8081
# GRAFT_HOST=ws://localhost:8080/ws
# GRAFT_CORS=http://localhost:5173
# PY_HOME=/Library/Frameworks/Python.framework/Versions/3.12   # if gateway cannot find Python
# GG_BIN=/path/to/gg

# Browser dashboard (set in ui/.env.local if you change the gateway address)
# VITE_GRAFT_HOST=ws://localhost:8080/ws
# VITE_GRAFT_MCP_URL=http://localhost:8081/mcp
