# OpenAI — primary model for outline, research synthesis, and writing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Kimi (Moonshot AI) — fallback writer when OpenAI is unavailable
KIMI_API_KEY=

# Groq — automatic fallback if the primary providers are unavailable
GROQ_API_KEY=

# Firecrawl — used for research (scraping competitor content once a topic is picked)
FIRECRAWL_API_KEY=

# Pexels — free, licensed, watermark-free images for articles
PEXELS_API_KEY=

# GitHub — creates the real pull request after pushing the publication branch
GITHUB_TOKEN=
